{
  "expo": {
    "name": "Oráculo Diário",
    "slug": "oraculo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oraculoapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bianchini.diogo.oraculoapp"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-full.png",
          "resizeMode": "cover",
          "imageWidth": 1200,
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover"
          },
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover"
          },
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "97b6fcab-8420-450c-b664-b394d504e993"
      }
    }
  }
}